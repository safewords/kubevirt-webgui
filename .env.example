# Copy to .env for local development.
APP_ENV=local
# A stable key keeps sign-ins valid across restarts: `kubevirt-webgui key:generate`
APP_KEY=
SERVER_HOST=127.0.0.1
SERVER_PORT=8006
# Which kubeconfig context to manage; unset uses in-cluster config, then the current context.
KUBE_CONTEXT=
# KUBE_API_SERVER=https://kubernetes.default.svc
# Offer "sign in as the server identity" (single-user desktop installs only).
AUTH_ALLOW_SERVER_IDENTITY=false
AUTH_SESSION_TTL=28800
CONSOLE_TICKET_TTL=60
# GUI_ALLOWED_ORIGINS=https://virt.example.com
# GUI_PLUGIN_URLS=/plugins/my-plugin.js
# GUI_DISABLED_EXTENSIONS=atomic-usb
GUI_PRODUCT_NAME=kubevirt-webgui
